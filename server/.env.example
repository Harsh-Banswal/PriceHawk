PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STORE_BASE_URL=https://demo.inelabteamdev.com
CRON_SECRET=your-cron-secret-token
SCRAPE_CONCURRENCY=2
SCRAPE_MAX_ATTEMPTS=3
NAV_TIMEOUT_MS=15000
HEADED=false
CLIENT_ORIGIN=http://localhost:5173

# Optional: Browserless.io remote browser (replaces local Chromium on Render)
# Get token at https://browserless.io/account — leave blank to use local Chromium
BROWSERLESS_TOKEN=
# Optional: override region (default: US West). Use production-lon for Europe.
BROWSERLESS_ENDPOINT=
