{
  "name": "price-tracker-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Scraper and catalog backend for price tracking service",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npx playwright install chromium",
    "start": "node src/index.js",
    "dev": "node --watch --watch-path=.env --watch-path=src src/index.js",
    "test": "node --test tests/**/*.test.js",
    "scrape:headed": "node scripts/headedRun.js",
    "scrape:headed:slow": "node scripts/headedRun.js --simulate slow",
    "scrape:headed:error": "node scripts/headedRun.js --simulate error"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "p-limit": "^6.2.0",
    "playwright": "^1.50.1"
  }
}
